rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /items/{itemId}/{imageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /returns/{transactionId}/{imageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
